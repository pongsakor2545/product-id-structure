# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/product_id

# Port the web server listens on
PORT=3000

# Google Sheets export (optional — leave blank to disable the export button)
# Paste the full contents of the service account JSON key file as one line.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Supabase Storage (required for image uploads — Settings -> API in your
# Supabase project dashboard). Leave blank to disable image uploads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
